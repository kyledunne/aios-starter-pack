{
  // Recommended extensions for an AIOS opened in VS Code. Part of the .vscode/
  // folder that ships with the pack; it prompts anyone who opens the repo to
  // install the extensions it expects. See guidance/setup-vscode.md.
  "recommendations": [
    // Claude Code and Codex — the AI coding agents that drive this AIOS from inside
    // the editor. Both read the same repo (AGENTS.md / CLAUDE.md, .claude/skills/),
    // so either can pick up the work. Install whichever you use; having both lets you
    // switch between them without leaving VS Code.
    "anthropic.claude-code",
    "openai.chatgpt",

    // Live Preview is the COMPLEMENT to the bundled AIOS HTML Preview extension:
    // it renders HTML that needs a real local server (fetch to a backend,
    // client-side routing) in an integrated browser (globe "Show Preview" icon,
    // or Alt+L Alt+O). For ordinary one-click preview of self-contained pages
    // (like planet-analogy.html), the bundled .vscode/aios-html-preview/ extension
    // handles it as the default *.html editor. That one isn't on the Marketplace,
    // so it can't be listed here — it installs from its bundled .vsix; see
    // .vscode/aios-html-preview/README.md and .vscode/settings.json.
    "ms-vscode.live-server"
  ]
}
