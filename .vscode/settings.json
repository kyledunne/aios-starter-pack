{
  // Editor defaults for an AIOS opened in VS Code. Part of the .vscode/ folder
  // that ships with the pack (inert unless the repo is opened in VS Code).
  // Opens Markdown AND HTML in a rendered preview, and applies the brand
  // stylesheet (markdown-preview.css) beside the Markdown one. See
  // guidance/setup-vscode.md to switch palette, disable, or rebrand.

  // Open Markdown and HTML files in rendered preview by default instead of raw
  // source. Markdown uses VS Code's built-in preview; HTML uses the AIOS HTML
  // Auto-Preview extension (recommended in extensions.json) — a one-click,
  // interactive webview render of the page. Until that extension is installed,
  // .html falls back to opening as source.
  //
  // The associations below cover the Explorer, Quick Open, etc. — but the Claude
  // Code chat panel BYPASSES editorAssociations and force-opens .md as source.
  // The AIOS Markdown Auto-Preview extension (also recommended in extensions.json)
  // reacts after the fact and swaps such a file back to preview.
  //
  // Both preview extensions are on the VS Code Marketplace and Open VSX, so opening
  // this repo prompts a one-click install (and they auto-update) — no manual setup.
  //
  // To edit a file's source, use the "Open Source" action (the {} icon top-right)
  // or right-click the file > Open With... > Text Editor.
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor",
    "*.html": "aios.htmlPreview"
  },
  // Live Preview (recommended in extensions.json) is the COMPLEMENT for pages that
  // need a real local server (fetch to a backend, client-side routing) — those
  // can't render in the static webview above. Open such a page and click the globe
  // "Show Preview" icon (or Alt+L Alt+O) to view it in the integrated browser.
  "livePreview.openPreviewTarget": "Embedded Preview",
  "livePreview.useIntegratedBrowser": true,
  // Apply a custom stylesheet to the built-in Markdown preview for nicer typography
  // and a brand palette. First entry is the structural base; the SECOND entry is the
  // band-style color theme. Swap that second filename to any file in
  // .vscode/markdown-themes/ to change palette or light/dark — or run
  // /setup-environment to pick one for you:
  //   light: ocean-bands, slate-bands, forest-bands, plum-bands
  //   dark:  ocean-bands-dark, slate-bands-dark, forest-bands-dark, plum-bands-dark
  // To drop the band styling entirely (plain headings + the base's own palette),
  // remove the second entry. See guidance/setup-vscode.md.
  "markdown.styles": [
    ".vscode/markdown-preview.css",
    ".vscode/markdown-themes/ocean-bands-dark.css"
  ]
}
